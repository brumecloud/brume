# The image that compiles Brume for Linux: the glibc of Debian 12, so the binary runs on Debian 12
# and 13 and Ubuntu 24.04 and 26.04. It compiles for its own architecture natively and for the
# other one with a cross gcc (SQLite is the only C dependency), and holds the official libduckdb
# of both architectures. scripts/release/build.sh passes the build arguments.
FROM rust:1.92-bookworm@sha256:e90e846de4124376164ddfbaab4b0774c7bdeef5e738866295e5a90a34a307a2

ARG TARGETARCH
RUN set -eux; \
    case "$TARGETARCH" in \
      arm64) cross='gcc-x86-64-linux-gnu libc6-dev-amd64-cross' ;; \
      amd64) cross='gcc-aarch64-linux-gnu libc6-dev-arm64-cross' ;; \
      *) echo "unsupported build machine: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    apt-get update; \
    apt-get install -y --no-install-recommends $cross; \
    rm -rf /var/lib/apt/lists/*; \
    rustup target add aarch64-unknown-linux-gnu x86_64-unknown-linux-gnu

# Debian names the native gcc with its triplet too, so these hold on either build machine.
ENV CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=aarch64-linux-gnu-gcc \
    CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER=x86_64-linux-gnu-gcc \
    CC_aarch64_unknown_linux_gnu=aarch64-linux-gnu-gcc \
    CC_x86_64_unknown_linux_gnu=x86_64-linux-gnu-gcc \
    AR_aarch64_unknown_linux_gnu=aarch64-linux-gnu-ar \
    AR_x86_64_unknown_linux_gnu=x86_64-linux-gnu-ar

# libduckdb and its headers, in /opt/duckdb/<arch>. The SHA-256s are pinned in build.sh.
ARG DUCKDB_VERSION
ARG DUCKDB_SHA256_ARM64
ARG DUCKDB_SHA256_AMD64
RUN set -eux; \
    for arch in arm64 amd64; do \
      case "$arch" in arm64) sum="$DUCKDB_SHA256_ARM64" ;; amd64) sum="$DUCKDB_SHA256_AMD64" ;; esac; \
      file="duckdb-shared-libs-linux-$arch.tar.gz"; \
      curl -fsSL -o "/tmp/$file" "https://github.com/duckdb/duckdb/releases/download/v$DUCKDB_VERSION/$file"; \
      echo "$sum  /tmp/$file" | sha256sum -c -; \
      mkdir -p "/opt/duckdb/$arch"; \
      tar -xzf "/tmp/$file" -C "/opt/duckdb/$arch" --no-same-owner; \
      rm "/tmp/$file"; \
    done
