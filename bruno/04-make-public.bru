meta {
  name: Remove plan authentication
  type: http
  seq: 12
}

patch {
  url: {{base_url}}/api/v1/plans/{{plan}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "auth": "none"
  }
}

tests {
  test("authentication is disabled", function() {
    expect(res.status).to.equal(200);
    expect(res.body.auth).to.equal("none");
  });
}
