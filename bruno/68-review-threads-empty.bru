meta {
  name: Deleting the last comment removed the thread
  type: http
  seq: 68
}

get {
  url: {{review_deployment_url}}/_brume/review/threads?site={{review_deployment_site}}&return_to={{review_deployment_return_to}}
  body: none
  auth: none
}

tests {
  test("the emptied thread disappeared with its comments", function() {
    expect(res.status).to.equal(200);
    expect(res.body.round.thread_count).to.equal(0);
    expect(res.body.round.comment_count).to.equal(0);
    expect(res.body.threads).to.have.length(0);
  });
}
