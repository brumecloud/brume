meta {
  name: Owner opens trusted toolbar
  type: http
  seq: 5
}

get {
  url: {{auth_url}}/toolbar/{{token_site}}?return_to={{token_return_to}}
  body: none
  auth: none
}

headers {
  Cookie: brume_auth_refresh={{refresh_token}}
}

script:post-response {
  const match = res.body.match(/name="action_token" value="([^"]+)"/);
  bru.setVar("toolbar_action", match?.[1]);
}

tests {
  test("only the owner receives toolbar management controls", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.include("Authentication");
    expect(bru.getVar("toolbar_action")).to.match(/^action_/);
  });
}
