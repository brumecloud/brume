meta {
  name: Owner invites a recipient to the review site
  type: http
  seq: 57
}

post {
  url: {{auth_url}}/toolbar/{{review_site}}/invitations
  body: json
  auth: none
}

headers {
  Cookie: brume_auth_refresh={{refresh_token}}
  Origin: {{plan_url}}
}

body:json {
  {}
}

script:post-response {
  bru.setVar("grant_invitation_url", res.body.url);
}

script:pre-request {
  const jar = bru.cookies.jar();
  await jar.setCookie(bru.getEnvVar("auth_url"), "brume_auth_refresh", bru.getEnvVar("refresh_token"));
}

tests {
  test("an invitation without return_to falls back to the site base URL", function() {
    expect(res.status).to.equal(200);
    expect(res.body.url).to.match(/\/invitations\/invite_/);
    const lifetimeHours = (Date.parse(res.body.expires_at) - Date.now()) / 3600000;
    expect(lifetimeHours).to.be.greaterThan(23).and.lessThanOrEqual(24);
  });
}
