meta {
  name: Owner deletes a whole thread
  type: http
  seq: 71
}

delete {
  url: {{review_deployment_url}}/_brume/review/threads/{{review_owner_thread_id}}?site={{review_deployment_site}}&return_to={{review_deployment_return_to}}
  body: none
  auth: none
}

headers {
  Cookie: brume_plan_access={{token}}
}

tests {
  test("the thread and its comments are removed in one call", function() {
    expect(res.status).to.equal(204);
  });
}
