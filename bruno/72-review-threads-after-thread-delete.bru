meta {
  name: The deleted thread is gone from the round
  type: http
  seq: 72
}

get {
  url: {{review_deployment_url}}/_brume/review/threads?site={{review_deployment_site}}&return_to={{review_deployment_return_to}}
  body: none
  auth: none
}

tests {
  test("the round is empty again and stays open", function() {
    expect(res.status).to.equal(200);
    expect(res.body.round.status).to.equal("open");
    expect(res.body.round.thread_count).to.equal(0);
    const ids = res.body.threads.map((thread) => thread.id);
    expect(ids).to.not.include(bru.getVar("review_owner_thread_id"));
  });
}
