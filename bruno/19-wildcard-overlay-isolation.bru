meta {
  name: Preserve toolbar-shaped wildcard paths
  type: http
  seq: 21
}

get {
  url: {{tunnel_url}}/_brume/overlay-state
  body: none
  auth: none
}

tests {
  test("a tunnel receives toolbar-shaped paths without interception", function() {
    expect(res.status).to.equal(200);
    expect(res.body.pathname).to.equal("/_brume/overlay-state");
    expect(res.body.instance).to.equal("second");
  });
}
