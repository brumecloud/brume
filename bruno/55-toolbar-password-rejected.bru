meta {
  name: Toolbar rejects short passwords
  type: http
  seq: 55
}

post {
  url: {{auth_url}}/toolbar/{{review_site}}/settings
  body: json
  auth: none
}

headers {
  Cookie: brume_auth_refresh={{refresh_token}}
  Origin: {{plan_url}}
}

body:json {
  {
    "auth": "password",
    "password": "short"
  }
}

script:pre-request {
  const jar = bru.cookies.jar();
  await jar.setCookie(bru.getEnvVar("auth_url"), "brume_auth_refresh", bru.getEnvVar("refresh_token"));
}

tests {
  test("passwords below eight characters are refused with a readable error", function() {
    expect(res.status).to.equal(400);
    expect(res.body.message).to.include("between 8 and 256 characters");
    expect(res.headers["access-control-allow-origin"]).to.equal(bru.getEnvVar("plan_url"));
  });
}
