meta {
  name: Owner creates token invitation
  type: http
  seq: 6
}

post {
  url: {{auth_url}}/toolbar/{{token_site}}/invitations
  body: formUrlEncoded
  auth: none
}

headers {
  Cookie: brume_auth_refresh={{refresh_token}}
}

body:form-urlencoded {
  action_token: {{toolbar_action}}
  return_to: {{token_return_to}}
}

script:post-response {
  bru.setVar("invitation_url", res.body.url);
}

tests {
  test("invitation is single-site and expires in one day", function() {
    expect(res.status).to.equal(200);
    expect(res.body.url).to.match(/\/invitations\/invite_/);
    const lifetimeHours = (Date.parse(res.body.expires_at) - Date.now()) / 3600000;
    expect(lifetimeHours).to.be.greaterThan(23).and.lessThanOrEqual(24);
  });
}
