meta {
  name: Static deployment index
  type: http
  seq: 15
}

get {
  url: {{deployment_url}}/
  body: none
  auth: none
}

tests {
  test("raw index HTML is served without the plan renderer", function() {
    expect(res.status).to.equal(200);
    expect(res.headers["content-type"]).to.include("text/html");
    expect(res.body).to.include("Brume static deployment fixture");
    expect(res.body).not.to.include("brume-layout");
    expect(res.body).to.include("data-brume-overlay-style");
    expect(res.body).to.include("data-brume-overlay-script");
    expect(res.body.indexOf("data-brume-overlay-script")).to.be.lessThan(res.body.indexOf("</body>"));
    expect(res.body).to.include("/_brume/overlay.js");
    expect(res.body).to.include("Geist Variable");
  });

  test("the overlay is injected once per response, not stacked", function() {
    // The overlay is added when the page is served rather than when it is
    // uploaded, so a bundle deployed before that change must have its baked-in
    // markup replaced instead of gaining a second toolbar.
    expect(res.body.split("data-brume-overlay-script").length - 1).to.equal(1);
    expect(res.body.split("data-brume-overlay-style").length - 1).to.equal(1);
  });
}
