meta {
  name: Static deployment index
  type: http
  seq: 15
}

get {
  url: {{deployment_url}}/
  body: none
  auth: none
}

tests {
  test("raw index HTML is served without the plan renderer", function() {
    expect(res.status).to.equal(200);
    expect(res.headers["content-type"]).to.include("text/html");
    expect(res.body).to.include("Brume static deployment fixture");
    expect(res.body).not.to.include("brume-layout");
    expect(res.body).to.include("data-brume-overlay-style");
    expect(res.body).to.include("data-brume-overlay-script");
    expect(res.body.indexOf("data-brume-overlay-script")).to.be.lessThan(res.body.indexOf("</body>"));
    expect(res.body).not.to.include("<iframe");
  });
}
