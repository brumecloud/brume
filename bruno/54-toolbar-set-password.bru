meta {
  name: Owner switches the review site to password access
  type: http
  seq: 54
}

post {
  url: {{auth_url}}/toolbar/{{review_site}}/settings
  body: json
  auth: none
}

headers {
  Cookie: brume_auth_refresh={{refresh_token}}
  Origin: {{plan_url}}
}

body:json {
  {
    "auth": "password",
    "password": "toolbar-e2e-password"
  }
}

script:pre-request {
  const jar = bru.cookies.jar();
  await jar.setCookie(bru.getEnvVar("auth_url"), "brume_auth_refresh", bru.getEnvVar("refresh_token"));
}

tests {
  test("settings update returns the new access state", function() {
    expect(res.status).to.equal(200);
    expect(res.body.auth_mode).to.equal("password");
    expect(res.body.has_password).to.equal(true);
  });
}
