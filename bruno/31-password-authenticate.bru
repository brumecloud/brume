meta {
  name: Authenticate password website
  type: http
  seq: 31
}

post {
  url: {{auth_url}}/access/password
  body: formUrlEncoded
  auth: none
}

headers {
  Origin: {{auth_url}}
}

body:form-urlencoded {
  site: {{password_site}}
  return_to: {{password_return_to}}
  password: e2e-password
}

settings {
  followRedirects: false
}

script:post-response {
  bru.setVar("password_ticket_url", res.headers.location);
}

tests {
  test("correct password creates a one-time site ticket", function() {
    expect(res.status).to.equal(303);
    expect(res.headers.location).to.include("/_brume/access/complete?ticket=site_ticket_");
  });
}
