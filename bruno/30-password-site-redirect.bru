meta {
  name: Password site redirects before loading
  type: http
  seq: 30
}

get {
  url: {{password_deployment_url}}/
  body: none
  auth: none
}

settings {
  followRedirects: false
}

script:post-response {
  const query = res.headers.location.split("?")[1] || "";
  const params = {};
  query.split("&").forEach(function(part) {
    const pair = part.split("=");
    params[decodeURIComponent(pair[0])] = decodeURIComponent(pair.slice(1).join("="));
  });
  bru.setVar("password_site", params.site);
  bru.setVar("password_return_to", params.return_to);
}

tests {
  test("password content is not loaded before authentication", function() {
    expect(res.status).to.equal(307);
    expect(res.headers.location).to.include(`${bru.getEnvVar("auth_url")}/access`);
  });
}
