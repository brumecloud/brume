meta {
  name: Token session loads website
  type: http
  seq: 11
}

get {
  url: {{plan_url}}/e2e/{{plan}}
  body: none
  auth: none
}

tests {
  test("scoped token session loads the hosted website", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.include("brume-layout");
    expect(res.body).to.include("data-brume-overlay-script");
    expect(res.body).not.to.include("<iframe");
  });
}
