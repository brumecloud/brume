meta {
  name: Owner reads toolbar access state
  type: http
  seq: 5
}

get {
  url: {{auth_url}}/toolbar/{{token_site}}/access
  body: none
  auth: none
}

headers {
  Cookie: brume_auth_refresh={{refresh_token}}
  Origin: {{plan_url}}
}

tests {
  test("the owner reads the current access settings as JSON", function() {
    expect(res.status).to.equal(200);
    expect(res.body.auth_mode).to.equal("token");
    expect(res.body.has_password).to.equal(false);
    expect(res.body.grants).to.be.an("array").that.is.empty;
  });

  test("the response is CORS-scoped to the site origin", function() {
    expect(res.headers["access-control-allow-origin"]).to.equal(bru.getEnvVar("plan_url"));
    expect(res.headers["access-control-allow-credentials"]).to.equal("true");
    expect(res.headers["cache-control"]).to.equal("private, no-store");
  });
}
