meta {
  name: Complete password website session
  type: http
  seq: 32
}

get {
  url: {{password_ticket_url}}
  body: none
  auth: none
}

settings {
  followRedirects: false
}

tests {
  test("website callback sets a one-day scoped session", function() {
    expect(res.status).to.equal(303);
    expect(res.headers.location).to.equal(bru.getVar("password_return_to"));
    expect(String(res.headers["set-cookie"])).to.include("brume_site_");
    expect(String(res.headers["set-cookie"])).to.include("Max-Age=86400");
  });
}
