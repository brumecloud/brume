meta {
  name: Prepare deployment deletion
  type: http
  seq: 23
}

post {
  url: {{base_url}}/api/v1/deployments/{{deployment}}/deletion-challenges
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:post-response {
  bru.setVar("deployment_delete_challenge", res.body.challenge);
}

tests {
  test("deployment deletion requires a short-lived challenge", function() {
    expect(res.status).to.equal(200);
    expect(res.body.challenge).to.match(/^delete_/);
    expect(res.body.expires_in_seconds).to.equal(300);
    expect(res.body.deployment.slug).to.equal(bru.getEnvVar("deployment"));
  });
}
