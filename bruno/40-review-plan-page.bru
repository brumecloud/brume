meta {
  name: Review plan page loads the overlay loader
  type: http
  seq: 40
}

get {
  url: {{plan_url}}/e2e/{{review_plan}}
  body: none
  auth: none
}

script:post-response {
  const match = String(res.body).match(/data-brume-site="([0-9a-f-]+)"/);
  bru.setVar("review_site", match ? match[1] : "");
  bru.setVar("review_return_to", `${bru.getEnvVar("plan_url")}/e2e/${bru.getEnvVar("review_plan")}`);
}

tests {
  test("the review plan serves the overlay loader script", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.include("data-brume-overlay-script");
    expect(res.body).to.include("/_brume/overlay.js");
    expect(res.body).not.to.include("<iframe");
    expect(String(bru.getVar("review_site"))).to.have.length.greaterThan(0);
  });
}
